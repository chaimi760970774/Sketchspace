# Copy this file to .env and fill in the values. .env is not committed.
# The server address is not set here: it is in .env.development (npm run dev) and .env.production (npm run build).

# Unsplash API access key, from https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# The Google client id is public and is in .env.development / .env.production too. Only set it here to try another one.
# VITE_GOOGLE_CLIENT_ID=
