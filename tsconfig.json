{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "types": ["vite/client"],
        "paths": { "/src/*": ["./src/*"] }
    },
    "include": ["src"]
}
