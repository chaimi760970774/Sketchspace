# Copy this file to .env and fill in the values. .env is not committed.

# Unsplash API access key, from https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Address of the Sketchspace server (https://github.com/yukistillalive/sketchspace-server)
# Defaults to http://localhost:3000 when not set
VITE_API_URL=http://localhost:3000
